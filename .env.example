# ==============================================================================
# CANDELARIAAPP - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copie este archivo como .env y complete con las credenciales locales seguras.
# NUNCA versione el archivo .env en Git ni almacene credenciales productivas aquí.

# Configuración de Aplicación
APP_NOMBRE="CandelariaAPP"
APP_ENV=desarrollo
APP_DEPURACION=true
APP_URL=http://localhost/app.candelaria/
APP_URL_TEST=http://app.candelaria.test/
APP_CLAVE=candelaria_secret_key_base_64_change_me_in_production
ZONA_HORARIA=America/Lima

# Configuración de Base de Datos (PDO / MySQL / MariaDB)
BD_DRIVER=mysql
BD_HOST=127.0.0.1
BD_PUERTO=3306
BD_NOMBRE=app_candelaria
BD_USUARIO=root
BD_CONTRASENA=
BD_CHARSET=utf8mb4
BD_COLATE=utf8mb4_unicode_ci

# Configuración de Sesiones
SESION_NOMBRE=candelaria_sid
SESION_DURACION=7200
SESION_SEGURA=false
SESION_HTTPONLY=true
SESION_SAMESITE=Lax

# Rutas de Almacenamiento
RUTA_ALMACENAMIENTO=almacenamiento
RUTA_LOGS=almacenamiento/logs/app.log
RUTA_TEMPORALES=almacenamiento/temporales
RUTA_ARCHIVOS=almacenamiento/archivos
LOG_NIVEL=debug

# Frontend y Assets
ASSETS_URL=/publico/activos/
FUENTE_OFICIAL="Fira Sans Extra Condensed"
ICONOGRAFIA_OFICIAL="Font Awesome Free 6.3.0"
SISTEMA_VISUAL="Alina Bootstrap 5"
