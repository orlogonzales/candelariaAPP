# ==============================================================================
# CANDELARIAAPP - PLANTILLA DE ENTORNO DE PRODUCCIÓN (.env.produccion.ejemplo)
# ==============================================================================
# Directiva DT-V1-DESPLIEGUE-001: Guía de configuración endurecida para servidor real.
# INSTRUCCIONES:
# 1. Copie este archivo a .env en el servidor de producción.
# 2. Asigne claves y contraseñas criptográficas seguras generadas al azar.
# 3. Configure DocumentRoot apuntando EXCLUSIVAMENTE a /publico.
# 4. Asegúrese de que APP_DEPURACION permanezca en false.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLICACIÓN Y NÚCLEO
# ------------------------------------------------------------------------------
APP_NOMBRE="CandelariaAPP"
APP_ENV=production
APP_DEPURACION=false
APP_URL=https://app.candelaria.pe/
APP_CLAVE=generar_clave_criptografica_segura_de_64_caracteres_aleatorios_hex
ZONA_HORARIA=America/Lima

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (MYSQL 8.0+ / MARIADB 10.5+)
# ------------------------------------------------------------------------------
BD_DRIVER=mysql
BD_HOST=127.0.0.1
BD_PUERTO=3306
BD_NOMBRE=candelaria_produccion
BD_USUARIO=usr_candelaria_prod
BD_CONTRASENA=contrasena_robusta_generada_especifica_produccion
BD_CHARSET=utf8mb4
BD_COLATE=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# 3. POLÍTICA DE SESIONES (ESTRICTA / HTTPS EXCLUSIVO)
# ------------------------------------------------------------------------------
SESION_NOMBRE=__Host-candelaria_sid
SESION_DURACION=7200
SESION_SEGURA=true
SESION_HTTPONLY=true
SESION_SAMESITE=Strict

# ------------------------------------------------------------------------------
# 4. ALMACENAMIENTO Y REGISTRO DE EVENTOS (LOGS)
# ------------------------------------------------------------------------------
RUTA_ALMACENAMIENTO=almacenamiento
RUTA_LOGS=almacenamiento/logs/app.log
RUTA_TEMPORALES=almacenamiento/temporales
RUTA_ARCHIVOS=almacenamiento/archivos
LOG_NIVEL=error

# ------------------------------------------------------------------------------
# 5. ASSETS Y FRONTEND
# ------------------------------------------------------------------------------
ASSETS_URL=/activos/
FUENTE_OFICIAL="Fira Sans Extra Condensed"
ICONOGRAFIA_OFICIAL="Font Awesome Free 6.3.0"
SISTEMA_VISUAL="Alina Bootstrap 5"

# ------------------------------------------------------------------------------
# 6. CREDENCIALES DE ACTIVACIÓN EXTERNA (SANDBOX VS LIVE)
# ------------------------------------------------------------------------------
# Pasarelas de Pago: Cambiar a credenciales de producción al autorizar pase real
CULQI_MODO=sandbox
CULQI_LLAVE_PUBLICA=pk_test_...
CULQI_LLAVE_PRIVADA=sk_test_...

NIUBIZ_MODO=sandbox
NIUBIZ_MERCHANT_ID=...
NIUBIZ_USER=...
NIUBIZ_PASSWORD=...

STRIPE_MODO=sandbox
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

MERCADOPAGO_MODO=sandbox
MERCADOPAGO_ACCESS_TOKEN=TEST-...
MERCADOPAGO_PUBLIC_KEY=TEST-...

# Meta WhatsApp Business Cloud API
WHATSAPP_MODO=sandbox
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_WABA_ID=...
WHATSAPP_BEARER_TOKEN=...
WHATSAPP_WEBHOOK_VERIFY_TOKEN=...
