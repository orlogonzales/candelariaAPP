{
    "name": "candelaria/app",
    "description": "CandelariaAPP V1 - Plataforma de Gestión y Producción Audiovisual Candelaria",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "O.G. Estudio Creativo",
            "email": "contacto@ogestudiocreativo.com"
        }
    ],
    "require": {
        "php": ">=8.3.0"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "Aplicacion\\": "aplicacion/",
            "Nucleo\\": "nucleo/",
            "Configuracion\\": "configuracion/"
        },
        "files": [
            "nucleo/Soporte/ayudantes.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pruebas\\": "pruebas/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
